{
  "schema": "closed-v5-public-source-allowlist-v1",
  "paths": [
    "ACTUAL_INVOCATION_GATE.md",
    "BASELINE_SOURCE_PINS.json",
    "CONTROL_PARITY_PROOF.json",
    "CURATED_ALLOWLIST.md",
    "CURATED_PACKET_SHA256.txt",
    "HANDOFF.md",
    "PRIMARY_EVIDENCE.md",
    "PROTOCOL_v5.md",
    "README.md",
    "REVIEW_RECEIPT.json",
    "REVIEW_RUNTIME_PINS.json",
    "SCHEMA.md",
    "TEST_PROOF.json",
    "VERIFICATION.json",
    "autoreview_v1.json",
    "autoreview_v1.log",
    "autoreview_v1.md",
    "collector.py",
    "handoff.json",
    "public_source_context/AUDIT.md",
    "public_source_context/CONFIGURED_TEMPLATE.json",
    "public_source_context/PROSPECTIVE_EIGHT_SLOT.md",
    "public_source_context/SOURCE_PINS.json",
    "review_prompt.md",
    "safe_to_promote_paths.json",
    "source_manifest.json",
    "source_snapshot_v1.json",
    "test_collector.py",
    "tests_v1.txt"
